# Riot API — nunca commitar a chave real. Comece com uma Development Key (expira a cada 24h).
RIOT_API_KEY=changeme
RIOT_PLATFORM_REGION=br1
RIOT_CONTINENT_REGION=americas

# Data Dragon
DATA_DRAGON_BASE_URL=https://ddragon.leagueoflegends.com
# Opcional: trava o app numa versão específica (ex: 14.15.1) em vez da mais recente.
# Deixe em branco para sempre usar a última versão publicada.
TARGET_PATCH_VERSION=

# Banco de dados próprio (SQLite para desenvolvimento local)
DATABASE_URL=sqlite:///./riftforge.db

# Usada só pelo Alembic (`alembic upgrade`/`revision --autogenerate`), nunca
# pelo app em si. Deve apontar pra conexão DIRETA do Supabase (porta 5432),
# não o pooler pgbouncer (porta 6543) usado acima em DATABASE_URL — DDL sob
# pgbouncer transaction-mode é instável. Sem essa variável, o Alembic cai no
# valor de DATABASE_URL (SQLite local, ok para dev).
MIGRATIONS_DATABASE_URL=

# App
APP_ENV=development
CORS_ORIGINS=http://localhost:5173

# Rate limiting por IP (sintaxe da lib slowapi/limits: "10/minute", "100/2minutes" etc.)
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_RIOT_PROXY=10/minute

# Calibração do modelo de score (Core/Estrutura_roadmap/16_BASELINES_CALIBRACAO.md).
# Valores abaixo são defaults razoáveis, não validados contra dados em volume real.
WILSON_Z=1.96
BASELINE_TRIM_PCT=0.10
BASELINE_MIN_CHAMPIONS=5
